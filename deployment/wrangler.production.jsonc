{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wonder-method-production",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "INQUIRY_MODE": "live",
    "RELEASE_APPROVED": "true",
    "NOTIFICATION_FROM": "Wonder and Method <notifications@notify.wonderandmethod.com>",
    "NOTIFICATION_TO": "palatis3@gmail.com",
    "SEARCH_INDEXING": "true",
    "PUBLIC_ORIGIN": "https://wonderandmethod.com",
    "JOURNEY_COUNTS": "aggregate"
    ,"NOTIFICATION_DAILY_LIMIT": "50"
    ,"NOTIFICATION_RESERVED_LIMIT": "10"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wonder-method-production",
      "database_id": "c1282e43-6f23-407d-abb0-92610107307b",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": false
    }
  },
  "account_id": "4fc7ad8717e64e119476c2dcf8f0666e",
  "routes": [
    {
      "pattern": "wonderandmethod.com",
      "zone_id": "81854dfe5ceecc678fc467f25cc325b5",
      "custom_domain": true
    },
    {
      "pattern": "www.wonderandmethod.com",
      "zone_id": "81854dfe5ceecc678fc467f25cc325b5",
      "custom_domain": true
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
