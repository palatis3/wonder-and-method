{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wonder-method-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "INQUIRY_MODE": "synthetic",
    "RELEASE_APPROVED": "false",
    "NOTIFICATION_FROM": "Wonder and Method <notifications@notify.wonderandmethod.com>",
    "NOTIFICATION_TO": "palatis3@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wonder-method-staging",
      "database_id": "dfcded52-c87b-48f4-959a-84079e1cec97",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": false
    }
  },
  "account_id": "4fc7ad8717e64e119476c2dcf8f0666e"
}
