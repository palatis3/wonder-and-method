{
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "wrangler": "4.150.0"
  },
  "name": "wonder-method-deployment",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "scripts": {
    "check": "wrangler deploy --dry-run --outdir dry-run",
